# Copy to backend/.env locally. Never commit real credentials.
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KNOWLEDGE_BUCKET=knowledge-private
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ENABLE_DEV_QUICK_LOGIN=false
DEMO_AUTH_DOMAIN=demo.invalid
# Set all DEMO_PASSWORD_* variables only in backend/.env or the administrator shell used by provision:demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
